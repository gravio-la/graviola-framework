{
  "name": "@graviola/fulltext-search-core",
  "version": "0.2.2",
  "description": "Engine-agnostic full-text search composite store, routing, JSON-LD stubs, and bootstrap (Layer 2)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/in-memory-adapter.d.ts",
      "import": "./dist/testing/in-memory-adapter.js",
      "require": "./dist/testing/in-memory-adapter.cjs",
      "default": "./dist/testing/in-memory-adapter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "depcheck": "depcheck",
    "lint": "eslint src/**/*.ts",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@graviola/edb-core-types": "workspace:*",
    "@graviola/search-facet-schema": "workspace:*",
    "@graviola/store-core": "workspace:*"
  },
  "devDependencies": {
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "@types/json-schema": "catalog:",
    "eslint-config-edb": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint-config-edb"
    ]
  }
}
