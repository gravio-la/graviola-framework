{
  "name": "@graviola/sparql-tools",
  "version": "0.1.0",
  "description": "Endpoint-agnostic SPARQL Graph Store Protocol dump/load/clear utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sparql-tools": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "db:dump": "bun run src/cli.ts dump",
    "db:load": "bun run src/cli.ts load",
    "db:clear": "bun run src/cli.ts clear"
  },
  "devDependencies": {
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "@types/bun": "latest",
    "tsup": "^8.3.6",
    "typescript": "5.8.2"
  },
  "license": "MIT"
}
