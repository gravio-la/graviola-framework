{
  "name": "@graviola/edb-detail-renderer",
  "version": "0.8.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint-fix": "eslint --fix src/**/*.{ts,tsx}",
    "test": "bun test",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@jsonforms/core": "catalog:jsonforms",
    "@graviola/edb-detail-renderer-core": "workspace:*",
    "@graviola/json-schema-utils": "workspace:*",
    "@graviola/edb-core-types": "workspace:*",
    "@graviola/edb-core-utils": "workspace:*",
    "@graviola/edb-markdown-renderer": "workspace:*",
    "@graviola/edb-data-mapping": "workspace:*",
    "@graviola/edb-state-hooks": "workspace:*",
    "@graviola/edb-ui-utils": "workspace:*",
    "@graviola/semantic-jsonform-types": "workspace:*",
    "lodash-es": "catalog:",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "peerDependencies": {
    "@mui/material": "catalog:mui",
    "@mui/icons-material": "catalog:mui",
    "@ebay/nice-modal-react": "^1.2",
    "@tanstack/react-query": "^5",
    "react": "catalog:",
    "react-i18next": ">=15",
    "@uiw/react-md-editor": "^4",
    "@uiw/react-markdown-preview": "^5"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@mui/material": "catalog:mui",
    "@mui/icons-material": "catalog:mui",
    "@uiw/react-md-editor": "^4",
    "happy-dom": "^20.0.0",
    "@tanstack/react-query": "^5",
    "@types/json-schema": "catalog:",
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "eslint-config-edb": "workspace:*",
    "react-i18next": "^15.7.4",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2",
    "@types/bun": "latest"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint-config-edb"
    ]
  }
}
