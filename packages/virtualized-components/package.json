{
  "name": "@graviola/edb-virtualized-components",
  "version": "1.2.1",
  "description": "MUI + react-virtuoso virtualized semantic list components for Graviola apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "depcheck": "depcheck",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"**/*.ts*\"",
    "lint-fix": "eslint --fix \"**/*.ts*\"",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@graviola/edb-detail-renderer-core": "workspace:*",
    "@graviola/edb-state-hooks": "workspace:*",
    "@graviola/semantic-views": "workspace:*"
  },
  "devDependencies": {
    "react-virtuoso": "catalog:",
    "@types/react": "catalog:",
    "@types/json-schema": "catalog:",
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*"
  },
  "peerDependencies": {
    "@mui/material": "catalog:mui",
    "@mui/icons-material": "catalog:mui",
    "react-virtuoso": "catalog:",
    "react": "catalog:"
  }
}
