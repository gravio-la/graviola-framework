{
  "name": "@graviola/edb-import-components",
  "version": "1.0.0",
  "description": "Staged import review UI components (creation feed, review panels)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@graviola/edb-import-staging": "workspace:*",
    "@graviola/edb-state-hooks": "workspace:*",
    "@mui/material": "catalog:mui",
    "@mui/icons-material": "catalog:mui",
    "react": "catalog:"
  },
  "dependencies": {
    "@graviola/edb-core-types": "workspace:*"
  },
  "devDependencies": {
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "@types/react": "catalog:",
    "tsup": "^8.0.0",
    "typescript": "5.8.2"
  },
  "license": "MIT"
}
