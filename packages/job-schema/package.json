{
  "name": "@graviola/job-schema",
  "version": "0.2.0",
  "description": "LinkML + JSON Schema for persisted JobRun / JobStep / SourceFetch records",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "generated",
    "linkml",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "scripts": {
    "schema:bundle": "../../../graviola-linkml-generator/.venv/bin/graviola-linkml bundle ./linkml/job.yaml -d ./generated",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**/*.ts",
    "test": "bun test",
    "release": "bun publish --access public",
    "pack-tarball": "bun pm pack"
  },
  "dependencies": {},
  "devDependencies": {
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "@types/json-schema": "catalog:",
    "eslint-config-edb": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint-config-edb"
    ]
  }
}
