{
  "name": "@graviola/formula-runtime",
  "version": "0.1.0",
  "description": "HyperFormula-backed evaluation runtime for compiled calc profiles (Layer 2)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "depcheck": "depcheck",
    "lint": "eslint src/**/*.ts",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@graviola/formula-dependency": "workspace:*",
    "hyperformula": "^3.0.0"
  },
  "devDependencies": {
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "eslint-config-edb": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": ["eslint-config-edb"]
  }
}
