{
  "name": "@graviola/facet-core",
  "version": "0.1.1",
  "description": "Headless facet descriptors, selection model, and filter algebra for Graviola stores",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "depcheck": "depcheck",
    "lint": "eslint src/**/*.ts",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@graviola/search-facet-schema": "workspace:*",
    "@graviola/store-core": "workspace:*",
    "@graviola/typed-query-types": "workspace:*"
  },
  "devDependencies": {
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "@types/json-schema": "catalog:",
    "eslint-config-edb": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2",
    "@types/bun": "latest"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint-config-edb"
    ]
  }
}
