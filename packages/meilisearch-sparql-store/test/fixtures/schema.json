{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Exhibition": {
      "type": "object",
      "properties": {
        "@id": { "type": "string" },
        "@type": { "type": "string" },
        "title": { "type": "string" },
        "venue": { "type": "string" },
        "year": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["@id", "@type"]
    },
    "Artist": {
      "type": "object",
      "properties": {
        "@id": { "type": "string" },
        "@type": { "type": "string" },
        "name": { "type": "string" },
        "bio": { "type": "string" }
      },
      "required": ["@id", "@type"]
    },
    "Place": {
      "type": "object",
      "properties": {
        "@id": { "type": "string" },
        "@type": { "type": "string" },
        "placeName": { "type": "string" },
        "description": { "type": "string" },
        "country": { "type": "string" }
      },
      "required": ["@id", "@type"]
    },
    "Curator": {
      "type": "object",
      "properties": {
        "@id": { "type": "string" },
        "@type": { "type": "string" },
        "curatorName": { "type": "string" }
      },
      "required": ["@id", "@type"]
    }
  }
}
