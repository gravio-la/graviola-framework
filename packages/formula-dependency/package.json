{
  "name": "@graviola/formula-dependency",
  "version": "0.1.0",
  "description": "Calc-profile compiler: dependency graph, stratification, boundary checks (Layer 2)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "depcheck": "depcheck",
    "lint": "eslint src/**/*.ts",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@graviola/json-schema-utils": "workspace:*",
    "@graviola/sidecar-core": "workspace:*",
    "@graviola/typed-query-types": "workspace:*",
    "graphology": "^0.25.4",
    "graphology-dag": "^0.4.1"
  },
  "devDependencies": {
    "@graviola/calc-fixtures": "workspace:*",
    "@graviola/edb-tsconfig": "workspace:*",
    "@graviola/edb-tsup-config": "workspace:*",
    "@types/json-schema": "catalog:",
    "eslint-config-edb": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint-config-edb"
    ]
  }
}
